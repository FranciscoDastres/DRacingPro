{
  "name": "dracing-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm dev:free-ports && pnpm --parallel --filter @dracing/frontend --filter @dracing/backend dev",
    "dev:free-ports": "fuser -k 5180/tcp 3001/tcp 2>/dev/null || true",
    "build:packages": "pnpm --filter @dracing/contracts build && pnpm --filter @dracing/database build",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "test": "pnpm build:packages && pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @dracing/database generate",
    "db:introspect": "pnpm --filter @dracing/database introspect",
    "db:migrate": "docker compose run --rm migrate",
    "dev:up": "docker compose up --build",
    "dev:status": "docker compose ps"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server@<1.19.13": ">=1.19.13"
    }
  }
}

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PORT=3000
APP_PORT=5173
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
VITE_API_URL=http://localhost:3000
DATABASE_URL=postgresql://dracing:dracing@localhost:5432/dracing
SESSION_SECRET=replace-with-at-least-32-random-characters
# Correos que reciben rol de administrador al iniciar sesión (separados por coma).
# El primero actúa como administrador principal del taller.
ADMIN_EMAILS=soporte.francisco.meza@gmail.com
# Credenciales OAuth de Google (Google Cloud Console → APIs y servicios → Credenciales).
# En desarrollo el backend corre en el puerto 3001; registra ESTA URI de redirección
# en Google y déjala igual aquí. En producción usa tu dominio HTTPS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/v1/auth/google/callback
POSTGRES_DB=dracing
POSTGRES_USER=dracing
POSTGRES_PASSWORD=dracing
POSTGRES_PORT=5432

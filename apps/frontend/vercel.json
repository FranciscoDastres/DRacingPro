{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://dracing-backend.onrender.com/v1/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://dracing-backend.onrender.com/health/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
